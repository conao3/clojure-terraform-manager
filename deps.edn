{:paths ["src" "resources"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.6"}
  org.clojure/tools.logging {:mvn/version "1.3.1"}
  org.clojure/data.json {:mvn/version "2.5.2"}
  org.slf4j/slf4j-simple {:mvn/version "2.0.20"}

  ;; graal
  com.github.clj-easy/graal-config-slf4j-simple
  {:git/url "https://github.com/conao3/graal-config"
   :git/sha "9983117c292f5f29375a4009e9390a0ab6ddb7eb"
   :deps/root "config/org.slf4j/slf4j-simple"}
  com.github.clj-easy/graal-build-time {:mvn/version "1.0.6"}}

 :aliases
 {:dev {:extra-paths ["dev"]
        :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}}
  :repl {:extra-deps {nrepl/nrepl {:mvn/version "1.8.0"}
                      cider/cider-nrepl {:mvn/version "0.63.1"}}
         :jvm-opts ["-Djdk.attach.allowAttachSelf"]
         :main-opts ["-m" "nrepl.cmdline"
                     "--interactive"
                     "--middleware" "[cider.nrepl/cider-middleware]"]}
  :test {:main-opts ["-e" "(require 'dev)" "-m" "kaocha.runner"]}
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build
          :jvm-opts ["-Dclojure.compiler.direct-linking=true"]}}}
